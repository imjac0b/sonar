{
  "name": "sonar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5"
    }
  },
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.3.4",
    "@sonar/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.7.2",
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.1",
    "typescript": "^5.9.3",
    "@sonar/config": "workspace:*"
  },
  "packageManager": "bun@1.3.5"
}

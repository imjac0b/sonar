{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonar",
  "version": "1.2.3",
  "identifier": "hk.com.jacob.sonar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sonar",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFQTkyRENBN0Q1QUQxRUYKUldUdjBWcDl5aTJwbmwzU25waHo0dHRVU0dXNVVrRGxiMmdWZDNlanQ3a3Y0VkZMd0drSnhkTVkK",
      "endpoints": [
        "https://github.com/imjac0b/sonar/releases/latest/download/latest.json"
      ]
    }
  }
}
